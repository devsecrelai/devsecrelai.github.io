<section class="text-primary dark:text-primary-dark body-font">
  <div class="container px-5 py-20 md:py-24 mx-auto">
    <div class="items-center text-center max-w-4xl mx-auto">
      <p class="mb-4 text-sm font-bold tracking-[0.2em] uppercase text-purple dark:text-purple-dark">Secure. Reliable. Human-centered.</p>
      <h1 class="mb-6 text-4xl font-extrabold tracking-tight leading-10 text-purple dark:text-purple-dark sm:text-5xl">
        <%= gettext("Welcome to DevSecRelAI") %>
      </h1>
      <p class="mb-6 text-xl leading-relaxed">
        <%= gettext("Practical learning for teams building secure, reliable, AI-enabled software.") %>
      </p>
      <p class="mb-8 leading-relaxed">
        <%= gettext("DevSecRelAI connects developer relations, security engineering, reliability, and responsible AI so safer delivery becomes part of everyday product work.") %>
      </p>
      <%= link(gettext("Explore the learning paths"), to: Routes.lesson_path(@conn, :index, current_locale(), :foundations), class: "inline-flex items-center px-5 py-3 font-extrabold text-white rounded-md bg-purple hover:text-white") %>
    </div>
  </div>
</section>

<div class="relative">
  <div class="absolute inset-0 flex items-center" aria-hidden="true"><div class="w-full border-t border-gray-300"></div></div>
  <div class="relative flex justify-center">
    <span class="px-2 text-lighter dark:text-lighter-dark dark:bg-body-dark bg-body">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" class="w-10 h-10 p-2 dark:text-heavy-dark text-white rounded-full bg-purple" viewBox="0 0 24 24"><path d="M12 3v18m9-9H3" /></svg>
    </span>
  </div>
</div>

<section class="text-primary body-font dark:text-primary-dark">
  <div class="container px-5 py-24 mx-auto">
    <div class="mb-16 text-center">
      <h2 class="mt-2 text-4xl font-extrabold tracking-tight leading-8 text-purple dark:text-purple-dark sm:text-4xl"><%= gettext("Build confidence into every release") %></h2>
      <p class="mt-3 text-xl text-heavy dark:text-heavy-dark"><%= gettext("Short, actionable lessons for the decisions that matter most.") %></p>
    </div>
    <div class="flex flex-wrap -mx-4 -mt-4 -mb-10 sm:-m-4 md:space-y-0 space-y-6">
      <div class="flex p-4 md:w-1/3">
        <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 mb-4 text-white rounded-full bg-purple"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-6 h-6" viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-14v4l3 2" /></svg></div>
        <div class="flex-grow pl-6"><p class="mb-2 text-xl font-semibold text-primary dark:text-primary-dark title-font"><%= gettext("Security by design") %></p><p class="text-base leading-relaxed"><%= gettext("Model threats early, reduce attack surface, and give every system a safer default.") %></p></div>
      </div>
      <div class="flex p-4 md:w-1/3">
        <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 mb-4 text-white rounded-full bg-purple"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-6 h-6" viewBox="0 0 24 24"><path d="m9 12 2 2 4-4m5-5v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8Z" /></svg></div>
        <div class="flex-grow pl-6"><p class="mb-2 text-xl font-semibold text-primary dark:text-primary-dark title-font"><%= gettext("Reliable delivery") %></p><p class="text-base leading-relaxed"><%= gettext("Protect the software supply chain, manage secrets well, and practice the response before an incident.") %></p></div>
      </div>
      <div class="flex p-4 md:w-1/3">
        <div class="inline-flex items-center justify-center flex-shrink-0 w-12 h-12 mb-4 text-white rounded-full bg-purple"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-6 h-6" viewBox="0 0 24 24"><path d="M12 18h.01M9.1 9a3 3 0 1 1 5.8 1c-.5 1-1.9 1.5-2.4 2.5-.2.4-.3.8-.3 1.5M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" /></svg></div>
        <div class="flex-grow pl-6"><p class="mb-2 text-xl font-semibold text-primary dark:text-primary-dark title-font"><%= gettext("Responsible AI") %></p><p class="text-base leading-relaxed"><%= gettext("Keep untrusted content out of the control plane and put clear guardrails around agents and tools.") %></p></div>
      </div>
    </div>
  </div>
</section>

<section class="bg-body dark:bg-body-dark">
  <div class="container px-5 py-20 mx-auto">
    <h2 class="mb-10 text-3xl font-extrabold tracking-tight text-center text-heavy dark:text-heavy-dark"><%= gettext("Choose a learning path") %></h2>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <%= for {title, section, description} <- [{gettext("Foundations"), :foundations, gettext("Threat modeling and safer architecture.")}, {gettext("Secure Delivery"), :secure_delivery, gettext("Dependencies, builds, and secrets.")}, {gettext("AI Security"), :ai_security, gettext("Prompt injection and agent controls.")}, {gettext("Resilience"), :resilience, gettext("Detection, response, and communication.")}] do %>
        <%= link(to: Routes.lesson_path(@conn, :index, current_locale(), section), class: "block p-6 border-2 border-transparent rounded-lg shadow-sm bg-nav dark:bg-nav-dark hover:border-purple") do %>
          <h3 class="mb-2 text-xl font-bold text-purple dark:text-purple-dark"><%= title %></h3>
          <p class="text-light dark:text-light-dark"><%= description %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%= render(DevSecRelAIWeb.PostView, "index.html", conn: @conn, posts: @posts) %>
